DATABASE_URL="file:./prisma/dev.db"

# UniFi Controller
# UniFi OS (UDM, UCG, Cloud Key Gen2+, UniFi OS Server): https://IP
# Network Application clássica (self-hosted): https://IP:8443
# Também configurável pelo painel em /admin/unifi (tem precedência sobre o .env).
UNIFI_URL="https://192.168.1.1:8443"
UNIFI_SITE="default"

# Forma de autenticação: auto (padrão) | apikey | password
#  auto     → usa a API Key quando houver e cai para usuário/senha se não suportado
#  apikey   → somente API Key (UniFi OS + Network 9 ou superior)
#  password → somente usuário/senha (todas as versões)
UNIFI_AUTH_MODE="auto"

# API Key (UniFi Network → Settings → Control Plane → Integrations → Create API Key)
UNIFI_API_KEY=""

# Usuário local da controladora (sem MFA) — necessário na Network Application clássica
UNIFI_USERNAME="portal-api"
UNIFI_PASSWORD="changeme"

# Controladoras com cert self-signed em LAN confiável: "true".
# Em produção, prefira confiar no CA da controladora setando
# NODE_EXTRA_CA_CERTS=/caminho/unifi-ca.pem e deixe esta var como "false".
UNIFI_INSECURE_TLS="true"

# Chave para cifrar segredos salvos no banco (senha/API Key da controladora).
# 32 bytes em hex (openssl rand -hex 32). Se vazia, é derivada do ADMIN_SECRET.
DATA_ENCRYPTION_KEY=""

# Guest authorization defaults (override per request if needed)
GUEST_DURATION_MIN="480"
GUEST_DOWN_KBPS="5120"
GUEST_UP_KBPS="2048"
# Cota de dados padrão em MB (vazio = sem cota)
GUEST_QUOTA_MB=""
# Os valores acima podem ser sobrescritos no painel (Customização → Perfil padrão de acesso).

# Portal aberto sem ?id=<MAC> (ex.: QR code): procura o MAC pelo IP do cliente
# na controladora. Requer proxy reverso com X-Real-IP. "false" desativa.
PORTAL_MAC_LOOKUP="true"

# Where to send the user after successful authorization
PORTAL_SUCCESS_URL="https://empresa.com.br"

# URL pública do portal (deep-links de QR/vouchers e login social — este exige https://)
PUBLIC_PORTAL_URL=""

# Admin panel
# Senha de PRIMEIRO ACESSO: entre com ela e crie os usuários em Painel → Usuários.
# Depois que existir um usuário, ela deixa de funcionar (salvo ADMIN_BREAK_GLASS).
ADMIN_PASSWORD="trocar-essa-senha"
# Emergência: "true" reabre o login por ADMIN_PASSWORD com usuários cadastrados.
ADMIN_BREAK_GLASS="false"
# ADMIN_SECRET mínimo 32 caracteres. Gere com: openssl rand -hex 32
ADMIN_SECRET="gere-com-openssl-rand-hex-32"

# Defina como "true" apenas se o app rodar com HTTPS
COOKIE_SECURE="false"

# Secret usado para chamadas internas (cron) via header
# `Authorization: Bearer ${CRON_SECRET}`. Gere com `openssl rand -hex 32`.
# Mínimo 16 caracteres; deixe vazio para desabilitar o bypass.
CRON_SECRET=""

# Retenção de logs de guest (em dias, mínimo 7, default 365 — Marco Civil art. 13 exige 1 ano).
# Cron diário em /api/admin/cleanup apaga registros mais antigos.
GUEST_RETENTION_DAYS="365"
# LGPD: anonimiza dados pessoais (nome, e-mail, telefone, documentos) após N dias,
# mantendo o registro de conexão (MAC, IP, horários) até GUEST_RETENTION_DAYS.
# Vazio = desligado.
PII_RETENTION_DAYS=""

# AdGuard Home Integration
ADGUARD_URL="http://192.168.1.50"
ADGUARD_USER="admin"
ADGUARD_PASSWORD="sua-senha-aqui"

# Token de acesso — locks de configuração
# Quando definidas, estas variáveis "travam" os respectivos campos no painel
# admin (formulário de criação de token e checkbox em Customização).
# Os tokens criados passarão a usar SEMPRE o valor da variável, e o admin
# não poderá editar o campo correspondente. Se a variável estiver vazia ou
# ausente, o campo permanece editável no painel.
#
# TOKEN_LOCK_REQUIRE="true"          # força requireToken e oculta o checkbox em Customização
# TOKEN_LOCK_DURATION_MIN="240"      # trava duração da sessão em 240 minutos
# TOKEN_LOCK_MAX_USES="1"            # trava máx. de usos em 1 (token de uso único)
# TOKEN_LOCK_DOWN_KBPS="5120"        # trava limite download (use "0" para travar como "sem limite")
# TOKEN_LOCK_UP_KBPS="2048"          # trava limite upload (use "0" para travar como "sem limite")
# TOKEN_LOCK_BYTES_QUOTA_MB="1024"   # trava quota de dados (use "0" para travar como "sem limite")
# TOKEN_LOCK_EXPIRES_IN_MIN="1440"   # trava validade em janela relativa (minutos a partir da criação)

# ─── Verificação por código (opcional — ative em Customização) ───────────────
# E-mail (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"            # "true" para porta 465
# SMTP_USER="wifi@empresa.com.br"
# SMTP_PASSWORD="senha-de-app"
# SMTP_FROM="Wi-Fi Empresa <wifi@empresa.com.br>"

# SMS: "twilio" ou "webhook" (POST {"to","message"} para qualquer gateway)
# SMS_PROVIDER="webhook"
# SMS_WEBHOOK_URL="https://gateway.exemplo.com/sms"
# SMS_WEBHOOK_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+15551234567"

# ─── Login social (opcional — ative em Customização) ─────────────────────────
# Requer PUBLIC_PORTAL_URL com https://. Redirect URI a cadastrar no provedor:
#   ${PUBLIC_PORTAL_URL}/api/portal/oauth/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT="common"
